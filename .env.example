# Copy to .env and fill in locally. Never commit real values.

# --- Database (local Docker) ---
POSTGRES_DB=vettyou
POSTGRES_USER=vettyou
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vettyou
SPRING_DATASOURCE_USERNAME=vettyou
SPRING_DATASOURCE_PASSWORD=change-me
APP_FRONTEND_ORIGIN=http://localhost:4200

# --- AI provider (backend only, not decided yet) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Mail (Milestone 5) ---
# 32+ character secret used only to encrypt stored IMAP passwords. Not the mailbox password.
MAIL_ENCRYPTION_KEY=
